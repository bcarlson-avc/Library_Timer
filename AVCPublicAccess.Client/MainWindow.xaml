<Window x:Class="AVCPublicAccess.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AVC Public Computer Access"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#F3F4F6">

    <Grid>

        <!-- ACCESS CODE VIEW -->
        <Grid x:Name="AccessCodeView">
            <Border Width="620"
                    Padding="40"
                    Background="White"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="AVC"
                               FontSize="26"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Public Computer Access"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Margin="0,8,0,30"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Enter the 6-digit access code provided by staff."
                               FontSize="17"
                               TextAlignment="Center"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Please note: When your session time expires, this computer will automatically reboot. A time-remaining countdown clock will be displayed during your session. You are responsible for monitoring your remaining time and saving your work before your session ends."
                               FontSize="14"
                               Foreground="DimGray"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="20,0,20,0"/>

                    <TextBox x:Name="CodeTextBox"
                             Width="260"
                             Height="60"
                             MaxLength="6"
                             FontSize="32"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             PreviewTextInput="CodeTextBox_PreviewTextInput"
                             TextChanged="CodeTextBox_TextChanged"/>

                    <Button x:Name="StartSessionButton"
                            Content="Start Session"
                            Width="260"
                            Height="52"
                            FontSize="18"
                            Margin="0,18,0,0"
                            IsEnabled="False"
                            Click="StartSessionButton_Click"/>

                    <TextBlock x:Name="ErrorText"
                               Margin="0,16,0,0"
                               FontSize="15"
                               Foreground="Firebrick"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>

                    <Separator Margin="0,28,0,18"/>

                    <TextBlock x:Name="ServiceStatusText"
                               Text="Checking session service..."
                               FontSize="14"
                               Foreground="DimGray"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="ComputerNameText"
                               FontSize="14"
                               Foreground="DimGray"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"/>

                </StackPanel>
            </Border>
        </Grid>

        <!-- ACTIVE SESSION VIEW -->
        <Grid x:Name="SessionView"
              Visibility="Collapsed">

            <Border Width="700"
                    Padding="40"
                    Background="White"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="Your Session Is Active"
                               FontSize="30"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Time Remaining"
                               FontSize="18"
                               Foreground="DimGray"
                               Margin="0,30,0,4"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="RemainingTimeText"
                               Text="00:00"
                               FontSize="72"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <!-- NON-MODAL WARNING BANNER -->
                    <Border x:Name="WarningBanner"
                            Visibility="Collapsed"
                            Margin="0,24,0,0"
                            Padding="20"
                            Background="#FFF3CD"
                            BorderBrush="#FFB300"
                            BorderThickness="2"
                            CornerRadius="8">

                        <StackPanel>
                            <TextBlock x:Name="WarningTitleText"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#7A4E00"
                                       HorizontalAlignment="Center"/>

                            <TextBlock x:Name="WarningMessageText"
                                       FontSize="17"
                                       Foreground="#7A4E00"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Please save your work before your session ends."
                               FontSize="17"
                               Margin="0,24,0,0"
                               HorizontalAlignment="Center"/>

                    <Border Margin="0,22,0,0"
                            Padding="12"
                            Background="#FFF4E5"
                            CornerRadius="6">

                        
                    </Border>

                    <Button x:Name="EndSessionButton"
                            Content="End Session"
                            Width="200"
                            Height="48"
                            FontSize="17"
                            Margin="0,26,0,0"
                            Click="EndSessionButton_Click"/>

                    <TextBlock x:Name="SessionStatusText"
                               Text="Session service connected"
                               FontSize="14"
                               Foreground="DimGray"
                               Margin="0,18,0,0"
                               HorizontalAlignment="Center"/>

                </StackPanel>
            </Border>
        </Grid>

        <!-- EXPIRED VIEW -->
        <Grid x:Name="ExpiredView"
              Visibility="Collapsed">

            <Border Width="650"
                    Padding="42"
                    Background="White"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="Session Ended"
                               FontSize="34"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="00:00"
                               FontSize="72"
                               FontWeight="Bold"
                               Margin="0,20,0,0"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Your computer session has expired."
                               FontSize="20"
                               Margin="0,18,0,0"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="The computer will now reboot."
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center"/>

                    

                    <Border Margin="0,26,0,0"
                            Padding="14"
                            Background="#FFF4E5"
                            CornerRadius="6">

                        
                    </Border>

                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>




