@page
@model AVCPublicAccess.Server.Pages.LoginModel
@{
    ViewData["Title"] = "Operator Login";
}

<div class="container mt-5" style="max-width: 420px;">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h2 class="mb-4">AVC Public Access</h2>
            <h5 class="mb-4">Operator Login</h5>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Passcode" class="form-label">
                        Operator Passcode
                    </label>

                    <input asp-for="Passcode"
                           type="password"
                           class="form-control"
                           autocomplete="current-password"
                           autofocus />

                    <span asp-validation-for="Passcode"
                          class="text-danger"></span>
                </div>

                <button type="submit"
                        class="btn btn-primary w-100">
                    Sign In
                </button>
            </form>
        </div>
    </div>
</div>
