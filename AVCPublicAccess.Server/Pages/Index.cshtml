@page
@model IndexModel
@{
    ViewData["Title"] = "Public Computer Management";
}

<div class="container py-4">

    <div class="avc-dashboard-header mb-4">
        <img src="/images/avc-logo.png"
             alt="Antelope Valley College"
             class="avc-dashboard-logo" />

        <div>
            <h1 class="display-6 fw-bold mb-1">
                AVC Public Computer Management
            </h1>

            <p class="text-muted mb-0">
                Public workstation session management
            </p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.GeneratedCode))
    {
        <div class="alert alert-success shadow-sm mb-4">

            <div class="row align-items-center">

                <div class="col-md-4 text-center">

                    <div class="small text-uppercase fw-bold">
                        Access Code
                    </div>

                    <div class="display-4 fw-bold">
                        @Model.GeneratedCode
                    </div>

                </div>

                <div class="col-md-8">

                    <strong>
                        @Model.GeneratedDuration minute session
                    </strong>

                    <br />

                    Code must be used before
                    <strong>@Model.GeneratedExpiration</strong>.

                    <br />

                    <span class="text-muted">
                        This code can be used once.
                    </span>

                </div>

            </div>

        </div>
    }

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body text-center">

                    <h2 class="display-5">
                        @Model.AvailableCount
                    </h2>

                    <div class="fw-bold">
                        Available
                    </div>

                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body text-center">

                    <h2 class="display-5">
                        @Model.InUseCount
                    </h2>

                    <div class="fw-bold">
                        In Use
                    </div>

                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body text-center">

                    <h2 class="display-5">
                        @Model.OfflineCount
                    </h2>

                    <div class="fw-bold">
                        Offline
                    </div>

                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <strong>Generate Access Code</strong>
        </div>

        <div class="card-body">

            <form method="post"
                  asp-page-handler="GenerateCode"
                  class="row g-3 align-items-end">

                <div class="col-md-4">

                    <label asp-for="DurationMinutes"
                           class="form-label">
                        Session Duration
                    </label>

                    <select asp-for="DurationMinutes"
                            class="form-select">

                        <option value="2">
                            2 minutes (TEST)
                        </option>

                        <option value="15">
                            15 minutes
                        </option>

                        <option value="30">
                            30 minutes
                        </option>

                        <option value="60">
                            60 minutes
                        </option>

                        <option value="90">
                            90 minutes
                        </option>

                        <option value="120">
                            120 minutes
                        </option>

                    </select>

                </div>

                <div class="col-md-4">

                    <button type="submit"
                            class="btn btn-primary">
                        Generate Access Code
                    </button>

                </div>

            </form>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-header d-flex justify-content-between align-items-center">

            <strong>Public Computers</strong>

            <span class="small text-muted">
                Live display
            </span>

        </div>

        <div class="card-body p-0">

            <table class="table table-hover mb-0">

                <thead class="table-light">

                    <tr>
                        <th>Computer</th>
                        
                        <th>Status</th>
                        <th>Remaining</th>
                        <th>Last Contact</th>
                        <th>Actions</th>
                    </tr>

                </thead>

                <tbody>

                @if (Model.Computers.Count == 0)
                {
                    <tr>

                        <td colspan="5"
                            class="text-center text-muted py-5">

                            No public computers have registered yet.

                        </td>

                    </tr>
                }
                else
                {
                    foreach (var computer in Model.Computers)
                    {
                        <tr>

                            <td class="fw-bold">
                                @computer.HostName
                            </td>

                            <td>

                                @if (computer.Status == "Available")
                                {
                                    <span class="badge bg-success">
                                        Available
                                    </span>
                                }
                                else if (computer.Status == "In Use")
                                {
                                    <span class="badge bg-primary">
                                        In Use
                                    </span>
                                }
                                else if (computer.Status == "Offline")
                                {
                                    <span class="badge bg-secondary">
                                        Offline
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @computer.Status
                                    </span>
                                }

                            </td>

                            <td>

                                @if (computer.Status == "In Use" &&
                                     computer.SessionExpiresUtc.HasValue)
                                {
                                    var expirationUtc =
                                        DateTime.SpecifyKind(
                                            computer.SessionExpiresUtc.Value,
                                            DateTimeKind.Utc);

                                    <span class="session-countdown fw-bold"
                                          data-expires="@expirationUtc.ToString("O")">
                                        Calculating...
                                    </span>
                                }
                                else
                                {
                                    <span>-</span>
                                }

                            </td>

                            <td>

                                @{
                                    var heartbeatUtc =
                                        DateTime.SpecifyKind(
                                            computer.LastHeartbeatUtc,
                                            DateTimeKind.Utc);
                                }

                                <span class="last-contact"
                                      data-heartbeat="@heartbeatUtc.ToString("O")">
                                    Calculating...
                                </span>

                            </td>

                            <td>
                                <form method="post"
                                      asp-page-handler="Retire"
                                      class="d-inline"
                                      onsubmit="return confirm('Retire @computer.HostName from the active dashboard?');">

                                    <input type="hidden"
                                           name="HostName"
                                           value="@computer.HostName" />

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">
                                        Retire
                                    </button>

                                </form>
                            </td>

                        </tr>
                    }
                }

                </tbody>

            </table>

        </div>

    </div>

    <div class="mt-3 d-flex justify-content-between">

        <span class="text-muted small">
            Server: AVC Public Access
        </span>

        <span class="text-muted small">
            Server data refreshes every 15 seconds
        </span>

    </div>

</div>

<script>
(function () {

    function formatRemaining(totalSeconds) {

        totalSeconds = Math.max(
            0,
            Math.floor(totalSeconds)
        );

        const hours =
            Math.floor(totalSeconds / 3600);

        const minutes =
            Math.floor((totalSeconds % 3600) / 60);

        const seconds =
            totalSeconds % 60;

        if (hours > 0) {

            return (
                hours +
                ":" +
                String(minutes).padStart(2, "0") +
                ":" +
                String(seconds).padStart(2, "0")
            );
        }

        return (
            String(minutes).padStart(2, "0") +
            ":" +
            String(seconds).padStart(2, "0")
        );
    }

    function formatAge(totalSeconds) {

        totalSeconds =
            Math.max(
                0,
                Math.floor(totalSeconds)
            );

        if (totalSeconds < 5) {
            return "Just now";
        }

        if (totalSeconds < 60) {
            return totalSeconds + " sec ago";
        }

        const minutes =
            Math.floor(totalSeconds / 60);

        if (minutes < 60) {

            if (minutes === 1) {
                return "1 min ago";
            }

            return minutes + " min ago";
        }

        const hours =
            Math.floor(minutes / 60);

        if (hours === 1) {
            return "1 hr ago";
        }

        return hours + " hr ago";
    }

    function updateLiveDisplay() {

        const now =
            new Date();

        document
            .querySelectorAll(".session-countdown")
            .forEach(function (element) {

                const expiration =
                    new Date(
                        element.dataset.expires
                    );

                const millisecondsRemaining =
                    expiration.getTime() -
                    now.getTime();

                if (millisecondsRemaining <= 0) {

                    element.textContent =
                        "Expired";

                    return;
                }

                element.textContent =
                    formatRemaining(
                        millisecondsRemaining / 1000
                    );
            });

        document
            .querySelectorAll(".last-contact")
            .forEach(function (element) {

                const heartbeat =
                    new Date(
                        element.dataset.heartbeat
                    );

                const ageMilliseconds =
                    now.getTime() -
                    heartbeat.getTime();

                element.textContent =
                    formatAge(
                        ageMilliseconds / 1000
                    );
            });
    }

    //
    // Update visible countdowns once per second.
    // This does NOT contact the server every second.
    //
    updateLiveDisplay();

    setInterval(
        updateLiveDisplay,
        1000
    );

    //
    // Reload server state every 15 seconds.
    //
    // Avoid automatic reload while the browser tab is
    // hidden so it does not create unnecessary traffic.
    //
    setInterval(function () {

        if (document.visibilityState === "visible") {
            window.location.reload();
        }

    }, 15000);

})();
</script>





